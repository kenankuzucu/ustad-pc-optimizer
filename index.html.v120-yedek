  return `<div class="kutu">
    <h2>${IK.roket} HIZLI İŞLEMLER</h2>
    <div style="display:flex;flex-direction:column;gap:8px">
      <button class="hizli yesil" id="hTemizle">${IK.temizlik}
        <div><b>AKILLI TEMİZLE</b><span>Tüm gereksiz dosyaları temizle</span></div></button>
      <button class="hizli mavi" id="hPerformans">${IK.roket}
        <div><b>PERFORMANSI ARTIR</b><span>Sistemi hızlandır · RAM + DNS + geçici</span></div></button>
      <button class="hizli kirmizi" id="hZorla">${IK.cop}
        <div><b>ZORLA KALDIR</b><span>Programı tamamen kaldır</span></div></button>
      <button class="hizli sari" id="hBaslangic">${IK.roket}
        <div><b>BAŞLANGIÇ YÖNETİMİ</b><span>Gereksiz başlangıçları kapat</span></div></button>
    </div>
  </div>
  <div class="kutu" id="hDurumKutu">
    <h2>${IK.bilgisayar} ANLIK DURUM</h2>
    <div id="hDurum"><div class="bos">ölçülüyor…</div></div>
  </div>`;
}
function hizliIslemlerBagla(){
  const b = (id,f)=>{ const el=$(id); if(el) el.onclick = f; };
  b('#hTemizle', async ()=>{
    const r = await apiPost('/api/temizlik/temizle',{secili:['gecici','tarayici','update','geri-donusum','diger']});
    bildir('Akıllı temizleme', r.silinenYazi+' kazanıldı ('+r.silinenDosya+' dosya).','basari');
    goster(AKTIF);
  });
  b('#hPerformans', hizlandir);
  b('#hZorla', ()=>goster('zorla'));
  b('#hBaslangic', ()=>goster('baslangic'));
  if($('#hDurum')) anlikDurumCiz();
}
async function anlikDurumCiz(){
  const d = await apiGet('/api/durum');
  if(d.hata) return;
  const el = $('#hDurum'); if(!el) return;
  el.innerHTML = `
    ${sayacKutu(IK.islemci,'CPU', d.cpuYuk+'%', d.cpuYuk, '#3b82f6')}
    <div style="height:7px"></div>
    ${sayacKutu(IK.ram,'RAM', d.ramYuzde+'%', d.ramYuzde, '#a855f7')}
    <div style="height:7px"></div>
    ${sayacKutu(IK.disk,'DISK', d.diskYuzde+'%', d.diskYuzde, '#22c55e')}
    <div style="height:9px"></div>
    <div class="satir"><span class="ad">Sağlık puanı</span><span class="boyut">${d.puan}/100</span></div>
    <div class="satir"><span class="ad">Bellek</span><span class="boyut">${boyut(d.ramKullanilan)}</span></div>
    <div class="satir"><span class="ad">Boş disk</span><span class="boyut">${boyut(d.diskBos)}</span></div>`;
}

/* ---------- ALT ÇUBUK ---------- */
function altCubukGuncelle(){
  $('#otoAnahtar').classList.toggle('acik', !!AYAR.otomatikTemizlik);
  $saf('#otoYazi').textContent = AYAR.otomatikTemizlik?'AÇIK':'KAPALI';
  $('#otoYazi').style.color = AYAR.otomatikTemizlik?'#86efac':'#8fb0d4';
  $saf('#altTemizlik').textContent = AYAR.sonTemizlik ? ('Son temizlik: '+AYAR.sonTemizlik) : 'Son temizlik: henüz yapılmadı';
}

/* ---------- BAŞLAT ---------- */
(async function basla(){
  const a = await apiGet('/api/ayar');
  AYAR = Object.assign(AYAR, a);
  altCubukGuncelle();
  $saf('#otoAnahtar').onclick = async ()=>{
    AYAR.otomatikTemizlik = !AYAR.otomatikTemizlik;
    altCubukGuncelle();
    await apiPost('/api/ayar/kaydet', AYAR);
    bildir('Otomatik temizlik', AYAR.otomatikTemizlik?'AÇILDI':'KAPATILDI', 'basari');
  };
  const n = await apiGet('/api/nabiz');
  $saf('#altAdmin').textContent = 'Yetki: ' + (n.yonetici?'YÖNETİCİ (tam)':'normal kullanıcı');
  $saf('#altSol').innerHTML = '● Sistem korunuyor — tüm ölçümler yerel, veri gönderilmiyor';
  temaUygula(AYAR.tema||'lacivert');
  if(AYAR.otomatikTemizlik){
    const r = await apiPost('/api/temizlik/temizle',{secili:['gecici','tarayici','diger']});
    if(r.silinenBayt>0) bildir('Otomatik temizlik', r.silinenYazi+' kazanıldı.','basari');
  }
/* ============================================================
   v1.2.0 — YENİ SAYFALAR (canlı izleme · hız · kurtarma · yönetim · güncelleme · alarm)
   Panel açılışta ÖNBELLEKTEN anında dolar (hızlı cevap), arkada tazelenir.
   ============================================================ */
/* Sayfa değiştikten sonra dönen asenkron kod eski DOM'a yazmaya çalışırsa
   sessizce yutar (null.textContent hatası olmaz). */
function $saf(sec){
  const e = document.querySelector(sec);
  if(e) return e;
  return {textContent:'', innerHTML:'', value:'', checked:false, disabled:false, dataset:{},
          style:{}, onclick:null, classList:{add(){}, remove(){}, toggle(){}, contains(){return false;}},
          appendChild(){}, after(){}, focus(){}, querySelector(){return null;},
          querySelectorAll(){return [];}};
}
const ONB = new Map();                       // sayfa içi önbellek
async function apiHizli(yol, ttl){
  const simdi = Date.now(), k = ONB.get(yol);
  if(k && (simdi - k.t) < (ttl || 30000)) return k.v;
  const v = await apiGet(yol);
  ONB.set(yol, {t: simdi, v});
  return v;
}
function onbTazele(){ ONB.clear(); }
function egri(dizi, renk, en, boy){
  en = en||262; boy = boy||58;
  const d = dizi.length ? dizi.slice(-60) : [0,0];
  const n = Math.max(2, d.length), adim = en/(n-1);
  const nk = d.map((y,i)=>{
    const x = i*adim, yv = boy - (Math.min(100, Math.max(0, Number(y)||0))/100)*(boy-4) - 2;
    return x.toFixed(1)+','+yv.toFixed(1);
  });
  const son = d[d.length-1]||0;
  const renkSon = son>=90?'#dc2626':(son>=70?'#eab308':renk);
  return `<svg width="${en}" height="${boy}" style="display:block">
    <defs><linearGradient id="g${renk.replace('#','')}" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="${renkSon}" stop-opacity=".45"/>
      <stop offset="100%" stop-color="${renkSon}" stop-opacity="0"/></linearGradient></defs>
    <polygon points="0,${boy} ${nk.join(' ')} ${en},${boy}" fill="url(#g${renk.replace('#','')})"/>
    <polyline points="${nk.join(' ')}" fill="none" stroke="${renkSon}" stroke-width="2"
      stroke-linejoin="round" stroke-linecap="round"/></svg>`;
}
function konus(metin){
  try{
    if(!('speechSynthesis' in window)) return false;
    const u = new SpeechSynthesisUtterance(metin);
    u.lang = 'tr-TR'; u.rate = 1.02; u.pitch = 1.0;
    const sesler = speechSynthesis.getVoices().filter(s=>/^tr/i.test(s.lang));
    if(sesler.length) u.voice = sesler[0];
    speechSynthesis.cancel(); speechSynthesis.speak(u);
    return true;
  }catch(e){ return false; }
}
function sesVarMi(){ return 'speechSynthesis' in window; }

/* ---------- CANLI İZLEME ---------- */
let CANLI_ZAMAN = null, CANLI_GEC = {cpu:[], ram:[], disk:[]};
async function canliCiz(){
  const c = await apiHizli('/api/canli', 3000);
  if(!c || c.hata){ return; }
  CANLI_GEC.cpu.push(c.cpu||0); CANLI_GEC.ram.push(c.ramYuzde||0); CANLI_GEC.disk.push(c.disk||0);
  Object.keys(CANLI_GEC).forEach(k=>{ if(CANLI_GEC[k].length>120) CANLI_GEC[k].shift(); });
  const yaz = (id, v)=>{ const e = document.getElementById(id); if(e) e.textContent = v; };
  yaz('cCpu', (c.cpu||0)+'%'); yaz('cRam', (c.ramYuzde||0)+'%'); yaz('cDisk', (c.disk||0)+'%');
  yaz('cSure', sure(c.sureSn||0)); yaz('cMhz', (c.cpuMhz||0)+' MHz');
  yaz('cRamBos', boyut((c.ramBosMB||0)*1048576));
  const g1 = document.getElementById('gCpu'), g2 = document.getElementById('gRam'), g3 = document.getElementById('gDisk');
  if(g1) g1.innerHTML = egri(CANLI_GEC.cpu, '#22d3ee');
  if(g2) g2.innerHTML = egri(CANLI_GEC.ram, '#a855f7');
  if(g3) g3.innerHTML = egri(CANLI_GEC.disk, '#22c55e');
  const s = document.getElementById('cSicak'), f = document.getElementById('cFan');
  if(s) s.textContent = c.sicakC ? (c.sicakC+' °C') : 'desteklemiyor';
  if(f) f.textContent = c.fanRpm ? (c.fanRpm+' dev/dk') : 'desteklemiyor';
  const not = document.getElementById('cNot');
  if(not) not.textContent = c.sicakC ? 'Sıcaklık gerçek sensörden okundu.' :
    'Bu anakart sıcaklık/fan sensörü yayınlamıyor (ACPI termal bölge yok) — uydurma değer gösterilmez.';
}
async function baglantiCiz(){
  const b = await apiHizli('/api/baglantilar', 8000);
  const kap = document.getElementById('bagKutu'); if(!kap || !b || b.hata) return;
  const surecler = (b.surecler||[]).map(s=>`<span class="kutucuk">${s.ad} · ${s.adet}</span>`).join(' ');
  const satir = (b.baglantilar||[]).slice(0,40).map(x=>`<div class="satir">
      <span class="ad">${x.surec||'?'} <span style="color:var(--soluk)">(PID ${x.pid})</span></span>
      <span class="boyut">${x.uzak}:${x.port}</span>
      <span class="durum"><span class="kutucuk mavi">${x.yerelPort}</span></span></div>`).join('');
  kap.innerHTML = `<div class="kutu"><h2>${IK.kalkan} DIŞARIYA AÇIK BAĞLANTILAR
      <span class="sag">${b.toplam||0} bağlantı · canlı</span></h2>
    <div style="display:flex;flex-wrap:wrap;gap:5px;margin:6px 0 10px">${surecler||'—'}</div>
    <div style="max-height:330px;overflow:auto">${satir||'<div class="bos">Dışarıya açık bağlantı yok.</div>'}</div></div>`;
}
SAYFALAR.canli = async function(){
  $saf('#orta').innerHTML = `
  <div class="kutu"><h2>${IK.islemci} CANLI İZLEME<span class="sag" id="canliDurum">4 saniyede bir yenileniyor</span></h2>
    <div class="sayaclar" id="canliSayac" style="margin-bottom:10px">
      ${sayacKutu(IK.islemci,'İŞLEMCİ','<span id="cCpu">—</span>',0,'#3b82f6')}
      ${sayacKutu(IK.ram,'BELLEK','<span id="cRam">—</span>',0,'#a855f7')}
      ${sayacKutu(IK.disk,'DİSK ETKİNLİĞİ','<span id="cDisk">—</span>',0,'#22c55e')}
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px">
      <div class="sayac"><div class="basi"><span>İŞLEMCİ</span><b id="cw1"></b></div><div id="gCpu"></div></div>
      <div class="sayac"><div class="basi"><span>BELLEK</span><b id="cw2"></b></div><div id="gRam"></div></div>
      <div class="sayac"><div class="basi"><span>DİSK</span><b id="cw3"></b></div><div id="gDisk"></div></div>
    </div>
    <div class="bilgi-satir">
      <div class="b"><div class="et">SICAKLIK</div><div class="de" id="cSicak">—</div></div>
      <div class="b"><div class="et">FAN DEVRİ</div><div class="de" id="cFan">—</div></div>
      <div class="b"><div class="et">BOŞ BELLEK</div><div class="de" id="cRamBos">—</div></div>
      <div class="b"><div class="et">İŞLEMCİ HIZI</div><div class="de" id="cMhz">—</div></div>
      <div class="b"><div class="et">AÇIK KALMA</div><div class="de" id="cSure">—</div></div>
    </div>
    <div class="alt-not" id="cNot" style="margin-top:9px;font-size:11.5px;color:var(--soluk)"></div>
  </div>
  <div id="bagKutu"><div class="kutu"><h2>${IK.kalkan} DIŞARIYA AÇIK BAĞLANTILAR</h2><div class="bos">okunuyor…</div></div></div>`;
  $saf('#sag').innerHTML = `<div class="kutu"><h2>${IK.saat} KONTROL</h2>
    <div class="hizli mavi" id="canliDurdur">${IK.saat}<div><b>İzlemeyi durdur / başlat</b><span>Ölçüm yükünü azaltır</span></div></div>
    <div class="hizli mor" id="kuralTazele">${IK.roket}<div><b>Önbelleği temizle</b><span>Tüm ölçümler yeniden yapılır</span></div></div>
    <div class="hizli sari" id="sesTest">${IK.pencere}<div><b>Sesli bildirimi dene</b><span>"Nöbetteyiz Üstad Kenan"</span></div></div>
  </div>`;
  const durum = $saf('#canliDurum');
  const dongu = async ()=>{
    await canliCiz();
    const span = document.getElementById('cw1'); if(span) span.textContent = (CANLI_GEC.cpu[CANLI_GEC.cpu.length-1]||0)+'%';
    const s2 = document.getElementById('cw2'); if(s2) s2.textContent = (CANLI_GEC.ram[CANLI_GEC.ram.length-1]||0)+'%';
    const s3 = document.getElementById('cw3'); if(s3) s3.textContent = (CANLI_GEC.disk[CANLI_GEC.disk.length-1]||0)+'%';
    const cubuk = $$('#canliSayac .cizgi i');
    const son = {0:CANLI_GEC.cpu.slice(-1)[0]||0, 1:CANLI_GEC.ram.slice(-1)[0]||0, 2:CANLI_GEC.disk.slice(-1)[0]||0};
    Object.keys(son).forEach(i=>{ if(cubuk[i]) cubuk[i].style.width = Math.min(100, son[i])+'%'; });
    if(AKTIF !== 'canli' && CANLI_ZAMAN){ clearInterval(CANLI_ZAMAN); CANLI_ZAMAN = null; return; }
  };
  await dongu(); await baglantiCiz();
  if(CANLI_ZAMAN) clearInterval(CANLI_ZAMAN);
  CANLI_ZAMAN = setInterval(async ()=>{ if(AKTIF!=='canli'){ clearInterval(CANLI_ZAMAN); CANLI_ZAMAN=null; return; }
    await dongu(); await baglantiCiz(); if(durum) durum.textContent = 'Son güncelleme: '+new Date().toLocaleTimeString('tr-TR'); }, 4000);
  $saf('#canliDurdur').onclick = ()=>{ if(CANLI_ZAMAN){ clearInterval(CANLI_ZAMAN); CANLI_ZAMAN=null; if(durum) durum.textContent='izleme durduruldu'; }
    else { goster('canli'); } };
  $saf('#kuralTazele').onclick = async ()=>{ onbTazele(); await apiPost('/api/onbellek/bosalt', {}); bildir('Önbellek','Ölçümler yeniden yapılacak','bilgi'); };
  $saf('#sesTest').onclick = ()=> bildir('Sesli bildirim', konus('Nöbetteyiz Üstad Kenan, sistem izleniyor.') ?
    'Sesli bildirim çalıştı.' : 'Bu panelde sesli okuma yok.', 'bilgi');
};

/* ---------- HIZ TESTİ & BENCHMARK ---------- */
function gecmisCubuk(liste, anahtar, renk){
  const d = (liste||[]).slice(-10);
  if(!d.length) return '<div class="bos">Henüz ölçüm yok.</div>';
  const en = Math.max(...d.map(x=>Number(x[anahtar])||1)) || 1;
  return d.map(x=>`<div class="satir"><span class="ad">${x.tarih||''}</span>
    <span class="boyut">${x[anahtar]}</span>
    <span class="durum" style="flex:1;margin-left:8px"><span class="ileri mavi" style="width:100%">
      <i style="width:${Math.round((Number(x[anahtar])||0)/en*100)}%;background:${renk}"></i></span></span></div>`).join('');
}
SAYFALAR.hiz = async function(){
  $saf('#orta').innerHTML = `
  <div class="kutu"><h2>${IK.disk} GERÇEK DİSK HIZ TESTİ<span class="sag">128 MB yazma + önbelleksiz okuma + 4K</span></h2>
    <div class="serit"><div class="sol"><div class="baslik">Disk hızını ölç</div>
      <div class="alt">128 MB dosya yazılır, gerçek (önbelleksiz) okuma ve 4K rastgele yazma ölçülür. Test dosyası silinir.</div></div>
      <button class="dev-buton" id="diskTest">${IK.roket} Testi Başlat</button></div>
    <div id="diskSonuc" class="bos">Ölçüm bekleniyor…</div></div>
  <div class="kutu"><h2>${IK.islemci} İŞLEMCİ + BELLEK BENCHMARK<span class="sag">önceki ölçümle kıyaslanır</span></h2>
    <div class="serit"><div class="sol"><div class="baslik">Kısa performans testi</div>
      <div class="alt">İşlemci tek çekirdek döngüsü + bellek kopyalama hızı ölçülür, geçmişle karşılaştırılır.</div></div>
      <button class="dev-buton" id="benchTest">${IK.roket} Testi Başlat</button></div>
    <div id="benchSonuc" class="bos">Ölçüm bekleniyor…</div></div>
  <div class="kutu"><h2>${IK.rapor} ÖLÇÜM GEÇMİŞİ</h2><div id="hizGecmis" class="bos">okunuyor…</div></div>`;
  $saf('#sag').innerHTML = `<div class="kutu"><h2>${IK.saat} BİLGİ</h2>
    <div class="serit"><div class="sol"><div class="baslik">Neden yavaş çıkabilir?</div>
      <div class="alt">Test sırasında başka program disk/kamera kullanıyorsa değerler düşük görünür. İkinci ölçüm daha doğru olur.</div></div></div>
    <div class="hizli mavi" id="hizYenile">${IK.roket}<div><b>Sonuçları yenile</b><span>Önbelleği atlar</span></div></div></div>`;
  const goster_ = async ()=>{
    const d = await apiGet('/api/onbellek').catch(()=>null);
    const kap = $saf('#hizGecmis');
    if(kap && d) kap.innerHTML = `<div class="satir"><span class="ad">Önbellek isabet oranı</span>
      <span class="boyut">%${d.isabetOrani||0}</span><span class="durum kutucuk ${(d.isabetOrani||0)>50?'yesil':'sari'}">${d.uretim||0} ölçüm üretildi</span></div>
      <div class="satir"><span class="ad">Ortalama ölçüm süresi</span><span class="boyut">${d.ortUretimSn||0} sn</span>
      <span class="durum kutucuk">${d.kayitSayisi||0} hazır kayıt</span></div>`;
  };
  await goster_();
  $saf('#diskTest').onclick = async ()=>{
    const b = $saf('#diskTest'); b.disabled = true; b.innerHTML = IK.saat+' Ölçülüyor…';
    $saf('#diskSonuc').innerHTML = '<div class="bos">128 MB yazılıyor, okunuyor… (yaklaşık 5-15 sn)</div>';
    const v = await apiGet('/api/disk-hiz');
    b.disabled = false; b.innerHTML = IK.roket+' Testi Başlat';
    if(v.hata || !v.ok){ $saf('#diskSonuc').innerHTML = '<div class="bos">Hata: '+(v.hata||'ölçülemedi')+'</div>'; return; }
    $saf('#diskSonuc').innerHTML = `
      <div class="bilgi-satir">
        <div class="b"><div class="et">YAZMA HIZI</div><div class="de">${v.yazmaMBs} MB/sn</div></div>
        <div class="b"><div class="et">OKUMA (önbellekli)</div><div class="de">${v.okumaMBs} MB/sn</div></div>
        <div class="b"><div class="et">OKUMA (gerçek disk)</div><div class="de">${v.okumaSogukMBs? v.okumaSogukMBs+' MB/sn' : 'ölçülemedi'}</div></div>
        <div class="b"><div class="et">4K RASTGELE</div><div class="de">${v.rastgeleIOPS||'—'} IOPS</div></div>
      </div>
      <div style="margin-top:8px">${gecmisCubuk((v.gecmis||[]).map(x=>({tarih:x.tarih, deger:x.yazma})), 'deger', '#38bdf8')}</div>`;
    bildir('Disk testi tamam', 'Yazma '+v.yazmaMBs+' MB/sn · Okuma '+(v.okumaSogukMBs||v.okumaMBs)+' MB/sn', 'bilgi');
    if(sesAyar.sesliUyari) konus('Disk hız testi tamamlandı Üstad Kenan.');
  };
  $saf('#benchTest').onclick = async ()=>{
    const b = $saf('#benchTest'); b.disabled = true; b.innerHTML = IK.saat+' Ölçülüyor…';
    const v = await apiGet('/api/benchmark');
    b.disabled = false; b.innerHTML = IK.roket+' Testi Başlat';
    if(!v.ok){ $saf('#benchSonuc').innerHTML = '<div class="bos">Hata: '+(v.hata||'?')+'</div>'; return; }
    const fark = v.fark===null ? '<span class="kutucuk">ilk ölçüm</span>' :
      (v.fark>=0? `<span class="kutucuk yesil">önceki ölçümden ${v.fark} puan hızlı</span>`
                : `<span class="kutucuk kirmizi">önceki ölçümden ${Math.abs(v.fark)} puan yavaş</span>`);
    $saf('#benchSonuc').innerHTML = `
      <div class="bilgi-satir">
        <div class="b"><div class="et">İŞLEMCİ PUANI</div><div class="de">${v.cpuPuani}</div></div>
        <div class="b"><div class="et">BELLEK PUANI</div><div class="de">${v.ramPuani}</div></div>
        <div class="b"><div class="et">KIYAS</div><div class="de">${fark}</div></div>
      </div>
      <div style="margin-top:10px"><div style="font-size:11.5px;color:var(--soluk);margin-bottom:4px">İŞLEMCİ PUANI GEÇMİŞİ</div>
        ${gecmisCubuk(v.cpuGecmis, 'cpu', '#22d3ee')}</div>`;
    if(sesAyar.sesliUyari) konus('Performans testi bitti Üstad Kenan. İşlemci puanı ' + Math.round(v.cpuPuani) + '.');
  };
  $saf('#hizYenile').onclick = async ()=>{ onbTazele(); await apiPost('/api/onbellek/bosalt', {}); await goster_(); bildir('Tazelendi','Ölçümler yenilenecek','bilgi'); };
};

/* ---------- KURTARMA & BAKIM ---------- */
function admDug(etiket, ikon){ return `<span class="kutucuk sari">yönetici gerekir</span>`; }
SAYFALAR.kurtarma = async function(){
  $saf('#orta').innerHTML = `
  <div class="kutu"><h2>${IK.kalkan} SİSTEM GERİ YÜKLEME NOKTASI<span class="sag" id="gnSag">okunuyor</span></h2>
    <div class="serit"><div class="sol"><div class="baslik">Geri yükleme noktası oluştur</div>
      <div class="alt">Bir şey ters giderse bilgisayarı bu ana döndürebilirsin. Yönetici yetkisi ister.</div></div>
      <button class="dev-buton" id="gnOlustur">${IK.kalkan} Oluştur</button></div>
    <div id="gnListe" class="bos">okunuyor…</div></div>
  <div class="kutu"><h2>${IK.disk} YEDEKLEME<span class="sag">klasör yedeği + sürücü yedeği</span></h2>
    <div class="serit"><div class="sol"><div class="baslik">Klasör yedeği (zip)</div>
      <div class="alt">Seçtiğin klasörler tek zip dosyasına alınır. Varsayılan hedef: Masaüstü.</div></div>
      <button class="dev-buton" id="ydBaslat">${IK.dosya||IK.disk} Yedekle</button></div>
    <div id="ydKlasorler" style="margin:8px 0">okunuyor…</div>
    <div class="serit"><div class="sol"><div class="baslik">Günlük otomatik yedek</div>
      <div class="alt">Her gün belirtilen saatte yedek alınır (zamanlanmış görev).</div></div>
      <input id="ydSaat" value="21:00" style="width:80px" class="inp">
      <button class="dev-buton" id="ydKur">${IK.saat} Kur</button>
      <button class="dev-buton" id="ydKaldir">Kaldır</button></div>
    <div class="serit"><div class="sol"><div class="baslik">Sürücüleri yedekle (pnputil)</div>
      <div class="alt">Kurulu tüm sürücü paketleri Masaüstü'ndeki klasöre aktarılır — format sonrası kurtarıcıdır. Yönetici ister.</div></div>
      <button class="dev-buton" id="surucuYedek">${IK.disk} Sürücüleri Yedekle</button></div>
    <div id="ydGecmis" class="bos"></div></div>
  <div class="kutu"><h2>${IK.rapor} OLAY GÜNLÜĞÜ (son 7 gün)<span class="sag" id="olSag"></span></h2>
    <div id="olayListe" class="bos">okunuyor…</div></div>
  <div class="kutu"><h2>${IK.tarama} SÜRÜCÜSÜ EKSİK AYGITLAR<span class="sag" id="aySag"></span></h2>
    <div id="aygitListe" class="bos">okunuyor…</div></div>
  <div class="kutu"><h2>${IK.saat} GERİ ALINABİLİR İŞLEMLER<span class="sag">yaptığım değişiklikler</span></h2>
    <div id="geriAlListe" class="bos">okunuyor…</div></div>`;
  $saf('#sag').innerHTML = `<div class="kutu"><h2>${IK.saat} KURTARMA ÖZETİ</h2><div id="kurOzet" class="bos">…</div></div>`;
  const gn = await apiHizli('/api/geri-noktalari', 20000);
  $saf('#gnSag').textContent = (gn.yonetici? 'yönetici: var' : 'yönetici: yok') + ' · ' + (gn.adet||0) + ' nokta';
  $saf('#gnListe').innerHTML = (gn.noktalar||[]).length ? (gn.noktalar||[]).map(x=>`<div class="satir">
      <span class="no">${x.sira}</span><span class="ad">${x.aciklama}</span>
      <span class="boyut">${x.tarih}</span></div>`).join('')
    : '<div class="bos">Hiç geri yükleme noktası yok. Soldaki "Oluştur" ile ilk noktayı açabilirsin (yönetici ister).</div>';
  $saf('#gnOlustur').onclick = async ()=>{
    let v = await apiPost('/api/geri-noktasi', {});
    if(v.yoneticiGerekli){
      if(!confirm('Geri yükleme noktası yönetici ister.\nYönetici penceresi açılsın mı?')) return;
      v = await apiPost('/api/geri-noktasi', {zorla:true});
    }
    bildir('Geri yükleme noktası', v.mesaj||'işlem gönderildi', v.ok?'bilgi':'hata');
    onbTazele();
  };
  const yd = await apiHizli('/api/yedek', 30000);
  const kl = yd.klasorler||[];
  $saf('#ydKlasorler').innerHTML = kl.map((k,i)=>`<label class="satir" style="cursor:pointer">
      <input type="checkbox" data-yd="${k.ad}" ${['Belgeler','Masaüstü','Resimler'].includes(k.ad)?'checked':''}>
      <span class="ad">${k.ad} <span style="color:var(--soluk)">${k.yol}</span></span>
      <span class="boyut">${k.boyut}</span></label>`).join('')
    + `<div style="font-size:11.5px;color:var(--soluk);margin-top:6px">Toplam: ${yd.toplam} · Hedef: ${yd.varsayilanHedef}</div>`;
  $saf('#ydGecmis').innerHTML = (yd.gecmis||[]).length ? '<div style="font-size:11.5px;color:var(--soluk);margin-top:8px">SON YEDEKLER</div>' +
    (yd.gecmis||[]).slice(-5).reverse().map(x=>`<div class="satir"><span class="ad">${x.klasor}</span>
      <span class="boyut">${x.boyut}</span><span class="durum kutucuk">${x.tarih}</span></div>`).join('') : '';
  $saf('#ydBaslat').onclick = async ()=>{
    const sec = $$('#ydKlasorler input:checked').map(x=>x.dataset.yd);
    if(!sec.length) return bildir('Yedek','Klasör seçilmedi','hata');
    if(!confirm(sec.join(', ')+' klasörleri zip olarak yedeklenecek. Devam?')) return;
    const b = $saf('#ydBaslat'); b.disabled = true; b.innerHTML = IK.saat+' yedekleniyor…';
    const v = await apiPost('/api/yedek/klasor', {secili: sec});
    b.disabled = false; b.innerHTML = IK.disk+' Yedekle';
    bildir('Yedek', v.mesaj||v.hata||'?', v.ok?'bilgi':'hata');
    if(v.ok && sesAyar.sesliUyari) konus('Yedekleme tamamlandı Üstad Kenan.');
    const y2 = await apiGet('/api/yedek'); onbTazele();
    $saf('#ydGecmis').innerHTML = (y2.gecmis||[]).slice(-6).reverse().map(x=>`<div class="satir"><span class="ad">${x.klasor}</span>
      <span class="boyut">${x.boyut}</span><span class="durum kutucuk">${x.tarih}</span></div>`).join('');
  };
  $saf('#ydKur').onclick = async ()=>{
    const v = await apiPost('/api/yedek/gorevi', {kur:true, saat: ($saf('#ydSaat').value||'21:00').trim()});
    bildir('Günlük yedek', v.mesaj||'', v.ok?'bilgi':'hata');
  };
  $saf('#ydKaldir').onclick = async ()=>{ const v = await apiPost('/api/yedek/gorevi', {kur:false});
    bildir('Günlük yedek', v.mesaj||'', 'bilgi'); };
  $saf('#surucuYedek').onclick = async ()=>{
    let v = await apiPost('/api/surucu-yedek', {});
    if(v.yoneticiGerekli){
      if(!confirm('Sürücü yedeği yönetici ister.\nYönetici penceresi açılsın mı?')) return;
      v = await apiPost('/api/surucu-yedek', {zorla:true});
    }
    bildir('Sürücü yedeği', v.mesaj||'?', v.ok?'bilgi':'hata');
  };
  const ol = await apiHizli('/api/olay', 60000);
  $saf('#olSag').textContent = (ol.adet||0)+' farklı olay · '+(ol.toplamOlay||0)+' kayıt';
  const sev = s=> s==='KRİTİK' ? 'kirmizi' : (s==='HATA' ? 'kirmizi' : 'sari');
  $saf('#olayListe').innerHTML = (ol.olaylar||[]).length ? (ol.olaylar||[]).map(x=>`<div class="satir">
      <span class="durum"><span class="kutucuk ${sev(x.seviye)}">${x.seviye}</span></span>
      <span class="ad">${x.kaynak} (${x.id}) — ${x.mesaj||''}</span>
      <span class="boyut">${x.adet} kez</span><span class="durum">${x.son}</span></div>`).join('')
    : '<div class="bos">Son 7 günde kritik/hata/uyarı kaydı yok.</div>';
  const ay = await apiHizli('/api/aygitlar', 60000);
  $saf('#aySag').textContent = (ay.toplamCihaz||0)+' aygıt tarandı';
  const kodlu = ay.kodlular||[];
  $saf('#aygitListe').innerHTML = (ay.adet||0)||(kodlu.length) ? [
      ...(ay.aygitlar||[]).map(x=>`<div class="satir"><span class="durum"><span class="kutucuk kirmizi">${x.durum}</span></span>
        <span class="ad">${x.ad} <span style="color:var(--soluk)">${x.sinif||''}</span></span>
        <span class="durum">${x.id||''}</span></div>`),
      ...kodlu.map(x=>`<div class="satir"><span class="durum"><span class="kutucuk kirmizi">kod ${x.kod}</span></span>
        <span class="ad">${x.ad}</span><span class="durum">${x.sade||''}</span></div>`)
    ].join('') : '<div class="bos">Harika — sürücüsü eksik/bozuk aygıt yok, tüm aygıtlar çalışıyor.</div>';
  const ga = await apiHizli('/api/geri-al', 20000);
  $saf('#geriAlListe').innerHTML = (ga.kayitlar||[]).length ? (ga.kayitlar||[]).map(x=>`<div class="satir">
      <span class="ad">${x.aciklama||x.tur}</span><span class="boyut">${x.ad||''}</span>
      <span class="durum kutucuk">${x.tarih||''}</span></div>`).join('')
    : '<div class="bos">Henüz geri alınabilir bir değişiklik yapılmadı.</div>';
  const gz = $saf('#kurOzet');
  if(gz) gz.innerHTML = `<div class="satir"><span class="ad">Geri yükleme noktası</span><span class="boyut">${gn.adet||0}</span></div>
    <div class="satir"><span class="ad">Kritik olay (7 gün)</span><span class="boyut">${ol.toplamOlay||0}</span></div>
    <div class="satir"><span class="ad">Sorunlu aygıt</span><span class="boyut">${ay.kodluAdet||ay.adet||0}</span></div>
    <div class="satir"><span class="ad">Son yedek</span><span class="boyut">${(yd.gecmis||[]).length? (yd.gecmis[yd.gecmis.length-1].tarih) : 'yok'}</span></div>`;
};

/* ---------- GÖREV & HİZMET YÖNETİMİ ---------- */
SAYFALAR.yonetim = async function(){
  $saf('#orta').innerHTML = `
  <div class="kutu"><h2>${IK.saat} ZAMANLANMIŞ GÖREVLER<span class="sag" id="gvSag">okunuyor</span></h2>
    <input id="gvAra" class="inp" placeholder="Görev ara (örn. Update)" style="width:100%;margin:6px 0 8px">
    <div id="gvListe" class="bos" style="max-height:420px;overflow:auto">okunuyor…</div></div>
  <div class="kutu"><h2>${IK.pencere} HİZMETLER<span class="sag" id="hzSag">okunuyor</span></h2>
    <input id="hzAra" class="inp" placeholder="Hizmet ara (örn. SysMain)" style="width:100%;margin:6px 0 8px">
    <div id="hzListe" class="bos" style="max-height:420px;overflow:auto">okunuyor…</div></div>`;
  $saf('#sag').innerHTML = `<div class="kutu"><h2>${IK.kalkan} NASIL ÇALIŞIR</h2>
    <div class="serit"><div class="sol"><div class="baslik">Kapat → geri aç</div>
      <div class="alt">Kapattığın her görev/hizmet "Geri alınabilir işlemler"e yazılır; Kurtarma sayfasından eski hâline dönebilirsin.</div></div></div>
    <div class="serit"><div class="sol"><div class="baslik">Windows hizmetleri</div>
      <div class="alt">"Güvenli liste" yok: SysMain, DiagTrack, Windows Update gibi hizmetleri kapatmak sistemi etkiler. Emin değilsen kapatma.</div></div></div></div>`;
  const gorevCiz = async (ara)=>{
    const g = await apiHizli('/api/gorevler'+(ara? '?ara='+encodeURIComponent(ara):''), ara?1000:30000);
    $saf('#gvSag').textContent = (g.toplam||0)+' görev · '+(g.kapali||0)+' kapalı';
    $saf('#gvListe').innerHTML = (g.gorevler||[]).slice(0,120).map(x=>`<div class="satir">
        <span class="durum"><span class="kutucuk ${x.acik?'yesil':'sari'}">${x.durum||'?'}</span></span>
        <span class="ad">${x.ad}<div style="font-size:11px;color:var(--soluk)">${x.yol||'\\'} · ${x.kodMetni||''} ${x.son? '· son: '+x.son : ''}</div></span>
        <button class="dev-buton kucuk" data-gorev="${encodeURIComponent(x.ad)}" data-yol="${encodeURIComponent(x.yol||'\\')}" data-kapat="${x.acik?1:0}">
          ${x.acik? 'Kapat' : 'Aç'}</button></div>`).join('') || '<div class="bos">Sonuç yok.</div>';
    $$('#gvListe button[data-gorev]').forEach(b=> b.onclick = async ()=>{
      const ad = decodeURIComponent(b.dataset.gorev), yol = decodeURIComponent(b.dataset.yol), kapat = b.dataset.kapat==='1';
      b.disabled = true;
      let v = await apiPost('/api/gorev', {ad, yol, kapat});
      if(v.yoneticiGerekli){
        if(confirm('"'+ad+'" için yönetici gerekiyor.\nYönetici penceresi açılsın mı?'))
          v = await apiPost('/api/gorev', {ad, yol, kapat, zorla:true});
        else v = {mesaj:'vazgeçildi'};
      }
      bildir('Görev', v.mesaj||v.hata||'', v.ok?'bilgi':'hata');
      b.disabled = false; onbTazele(); gorevCiz($saf('#gvAra').value.trim());
    });
  };
  const hizmetCiz = async (ara)=>{
    const h = await apiHizli('/api/hizmet'+(ara? '?ara='+encodeURIComponent(ara):''), ara?1000:30000);
    $saf('#hzSag').textContent = (h.toplam||0)+' hizmet · '+(h.calisan||0)+' çalışıyor';
    $saf('#hzListe').innerHTML = (h.hizmetler||[]).slice(0,120).map(x=>`<div class="satir">
        <span class="durum"><span class="kutucuk ${x.durum==='Running'?'yesil':'sari'}">${x.durum==='Running'?'çalışıyor':'durdu'}</span></span>
        <span class="ad">${x.etiket||x.ad}<div style="font-size:11px;color:var(--soluk)">${x.ad} · başlangıç: ${x.baslangic}</div></span>
        <button class="dev-buton kucuk" data-h="durdur" data-had="${encodeURIComponent(x.ad)}">Durdur</button>
        <button class="dev-buton kucuk" data-h="baslat" data-had="${encodeURIComponent(x.ad)}">Başlat</button>
        <button class="dev-buton kucuk" data-h="baslangic" data-had="${encodeURIComponent(x.ad)}" data-bs="${x.baslangic==='Auto'?'Manual':'Auto'}">${x.baslangic==='Auto'?'Elle':'Otomatik'}</button></div>`).join('') || '<div class="bos">Sonuç yok.</div>';
    $$('#hzListe button[data-h]').forEach(b=> b.onclick = async ()=>{
      const ad = decodeURIComponent(b.dataset.had);
      let govde = {ad, islem: b.dataset.h};
      if(b.dataset.bs) govde.baslangic = b.dataset.bs === 'Auto' ? 'Automatic' : 'Manual';
      b.disabled = true;
      let v = await apiPost('/api/hizmet', govde);
      if(v.yoneticiGerekli){
        if(confirm('"'+ad+'" hizmeti için yönetici gerekiyor.\nYönetici penceresi açılsın mı?')){
          govde.zorla = true; v = await apiPost('/api/hizmet', govde);
        } else v = {mesaj:'vazgeçildi'};
      }
      bildir('Hizmet', v.mesaj||v.hata||'', v.ok?'bilgi':'hata');
      b.disabled = false; onbTazele(); hizmetCiz($saf('#hzAra').value.trim());
    });
  };
  await gorevCiz(''); await hizmetCiz('');
  let z1=null, z2=null;
  $saf('#gvAra').oninput = ()=>{ clearTimeout(z1); z1 = setTimeout(()=>gorevCiz($saf('#gvAra').value.trim()), 600); };
  $saf('#hzAra').oninput = ()=>{ clearTimeout(z2); z2 = setTimeout(()=>hizmetCiz($saf('#hzAra').value.trim()), 600); };
};

/* ---------- AĞ · GÜNCELLEME · GİZLİLİK ---------- */
SAYFALAR.guncelleme = async function(){
  $saf('#orta').innerHTML = `
  <div class="kutu"><h2>${IK.tarama} WINDOWS UPDATE<span class="sag" id="guSag">okunuyor</span></h2>
    <div id="guSon" class="bos">okunuyor…</div>
    <div id="guListe" class="bos">okunuyor…</div></div>
  <div class="kutu"><h2>${IK.pencere} WINGET — PROGRAM GÜNCELLEMELERİ<span class="sag" id="wgSag">okunuyor</span></h2>
    <div id="wgListe" class="bos">okunuyor…</div>
    <div class="serit" style="margin-top:6px"><div class="sol"><div class="baslik">Tümünü güncelle</div>
      <div class="alt">winget ile güncellenebilir tüm programlar arka planda güncellenir.</div></div>
      <button class="dev-buton" id="wgHepsi">${IK.roket} Tümünü Güncelle</button></div></div>
  <div class="kutu"><h2>${IK.kalkan} GİZLİLİK — TELEMETRİ<span class="sag" id="tlSag">okunuyor</span></h2>
    <div id="tlDurum" class="bos">okunuyor…</div>
    <div class="serit"><div class="sol"><div class="baslik">Telemetriyi 0'a çek + reklam kimliğini kapat</div>
      <div class="alt">Reklam kimliği hemen kapanır; telemetri ve DiagTrack için yönetici gerekir.</div></div>
      <button class="dev-buton" id="tlKapat">${IK.kalkan} Kapat</button></div></div>
  <div class="kutu"><h2>${IK.pencere} YAZICI KUYRUĞU<span class="sag" id="yzSag">okunuyor</span></h2>
    <div id="yzListe" class="bos">okunuyor…</div>
    <div class="serit"><div class="sol"><div class="baslik">Kuyruğu temizle</div>
      <div class="alt">Takılan yazdırma işleri silinir, yazdırma servisi yeniden başlatılır (yönetici ister).</div></div>
      <button class="dev-buton" id="yzTemizle">${IK.cop} Temizle</button></div></div>
  <div class="kutu"><h2>${IK.ag||IK.kalkan} WIFI KANAL TARAYICI<span class="sag" id="wfSag">okunuyor</span></h2>
    <div id="wfListe" class="bos">okunuyor…</div></div>`;
  $saf('#sag').innerHTML = `<div class="kutu"><h2>${IK.saat} ÖZET</h2><div id="guOzet" class="bos">…</div></div>`;
  const son = await apiHizli('/api/son-guncelleme', 60000);
  $saf('#guSag').textContent = (son.adet||0)+' son güncelleme';
  $saf('#guSon').innerHTML = `<div class="satir"><span class="ad">Son başarılı kurulum</span>
    <span class="boyut">${son.sonBasari||'kayıt yok'}</span></div>`;
  $saf('#guListe').innerHTML = (son.liste||[]).map(x=>`<div class="satir"><span class="ad">${x.kb} — ${x.aciklama||''}</span>
    <span class="boyut">${x.tarih||''}</span></div>`).join('') || '<div class="bos">güncelleme kaydı yok</div>';
  const gunc = await apiHizli('/api/guncelleme?tur=windows', 900000);
  const bekleyen = document.createElement('div');
  bekleyen.innerHTML = (gunc.guncellemeler||[]).length ? '<div style="font-size:11.5px;color:var(--soluk);margin:8px 0 4px">BEKLEYEN GÜNCELLEMELER</div>' +
    (gunc.guncellemeler||[]).map(x=>`<div class="satir"><span class="ad">${x.baslik}</span>
      <span class="boyut">${x.boyutMB? x.boyutMB+' MB':''}</span></div>`).join('')
    : '<div class="bos">Bekleyen Windows güncellemesi görünmüyor'+(gunc.hata? ' ('+gunc.hata+')':'')+'.</div>';
  $saf('#guListe').after(bekleyen);
  const wg = await apiHizli('/api/winget', 300000);
  if(!wg.kurulu){
    $saf('#wgSag').textContent = 'kurulu değil';
    $saf('#wgListe').innerHTML = `<div class="bos">${wg.hata||'winget yok'}<br>Microsoft Store → "App Installer" kurulunca burası otomatik çalışır.</div>`;
  } else {
    $saf('#wgSag').textContent = (wg.adet||0)+' güncellenebilir program';
    $saf('#wgListe').innerHTML = (wg.paketler||[]).map(x=>`<div class="satir"><span class="ad">${x.ad}
      <div style="font-size:11px;color:var(--soluk)">${x.id}</div></span>
      <span class="boyut">${x.mevcut} → ${x.yeni}</span></div>`).join('') || '<div class="bos">Güncellenecek program yok — hepsi güncel.</div>';
  }
  $saf('#wgHepsi').onclick = async ()=>{ if(!confirm('Tüm programlar güncellenecek. Devam?')) return;
    const v = await apiPost('/api/winget/guncelle', {hepsi:true}); bildir('winget', v.mesaj||v.hata, v.ok?'bilgi':'hata'); };
  const tl = await apiHizli('/api/telemetri', 30000);
  const t = tl.durum||{};
  $saf('#tlSag').textContent = 'telemetri: '+t.telemetri;
  $saf('#tlDurum').innerHTML = `<div class="satir"><span class="ad">Telemetri düzeyi (0 = kapalı)</span>
      <span class="boyut"><span class="kutucuk ${t.telemetri===0?'yesil':'kirmizi'}">${t.telemetri}</span></span></div>
    <div class="satir"><span class="ad">Reklam kimliği kullanımı</span>
      <span class="boyut"><span class="kutucuk ${t.reklamKimlik===0?'yesil':'kirmizi'}">${t.reklamKimlik===0?'kapalı':'açık'}</span></span></div>
    <div class="satir"><span class="ad">DiagTrack hizmeti</span>
      <span class="boyut"><span class="kutucuk ${t.diagTrack==='Stopped'?'yesil':'kirmizi'}">${t.diagTrack}</span></span></div>`;
  $saf('#tlKapat').onclick = async ()=>{
    let v = await apiPost('/api/telemetri/kapat', {});
    if(v.yoneticiGerekli){
      if(!confirm('Telemetri + DiagTrack için yönetici gerekir.\nYönetici penceresi açılsın mı?')) return;
      v = await apiPost('/api/telemetri/kapat', {zorla:true});
    }
    bildir('Gizlilik', v.mesaj||'', v.ok?'bilgi':'uyari'); onbTazele();
  };
  const yz = await apiHizli('/api/yazici', 30000);
  $saf('#yzSag').textContent = (yz.adet||0)+' yazıcı · spooler: '+yz.spooler;
  $saf('#yzListe').innerHTML = (yz.yazicilar||[]).map(x=>`<div class="satir"><span class="ad">${x.ad}</span>
    <span class="boyut">${x.durum||''}</span>
    <span class="durum"><span class="kutucuk ${x.kuyruk>0?'sari':'yesil'}">${x.kuyruk} iş</span></span></div>`).join('')
    || '<div class="bos">Yazıcı bulunamadı.</div>';
  $saf('#yzTemizle').onclick = async ()=>{
    let v = await apiPost('/api/yazici/temizle', {});
    if(v.yoneticiGerekli){
      if(!confirm('Kuyruk temizliği yönetici ister.\nYönetici penceresi açılsın mı?')) return;
      v = await apiPost('/api/yazici/temizle', {zorla:true});
    }
    bildir('Yazıcı', v.mesaj||'', v.ok?'bilgi':'uyari'); onbTazele();
  };
  const wf = await apiHizli('/api/wifi', 60000);
  $saf('#wfSag').textContent = (wf.adet||0)+' ağ · önerilen kanal: '+(wf.onerilenKanal||'—');
  $saf('#wfListe').innerHTML = (wf.aglar||[]).map(a=>`<div class="satir"><span class="ad">${a.ssid||'(gizli)'}
    <div style="font-size:11px;color:var(--soluk)">${a.bssid||''} ${a.bant||''}</div></span>
    <span class="boyut">kanal ${a.kanal||'—'}</span>
    <span class="durum"><span class="kutucuk ${a.sinyal>=70?'yesil':(a.sinyal>=40?'sari':'kirmizi')}">%${a.sinyal!==null? a.sinyal : '—'}</span></span></div>`).join('')
    || '<div class="bos">Wi-Fi ağı bulunamadı (kablolu bağlantı olabilir).</div>';
  const gz = $saf('#guOzet');
  if(gz) gz.innerHTML = `<div class="satir"><span class="ad">Bekleyen Windows güncellemesi</span><span class="boyut">${gunc.toplam||0}</span></div>
    <div class="satir"><span class="ad">Güncellenebilir program</span><span class="boyut">${wg.kurulu? (wg.adet||0) : 'winget yok'}</span></div>
    <div class="satir"><span class="ad">Yazıcı kuyruğu</span><span class="boyut">${yz.kuyrukToplam||0} iş</span></div>
    <div class="satir"><span class="ad">Wi-Fi ağı</span><span class="boyut">${wf.adet||0}</span></div>`;
};

/* ---------- ALARM & SESLİ BİLDİRİM ---------- */
let sesAyar = {sesliUyari:true};
let ALARM_ZAMAN = null;
function alarmKontrol(){
  return apiHizli('/api/alarm', 15000).then(v=>{
    sesAyar = v.ayar || sesAyar;
    const k = document.getElementById('alarmSerit');
    if(v.alarmVar){
      const metin = (v.ihlal||[]).join(' · ');
      if(k){ k.innerHTML = `<div class="kutu" style="border-color:#dc2626;background:linear-gradient(90deg,#3a0d0d,#1a0808)">
        <h2 style="color:#ffd7d7">⚠ DİKKAT — EŞİK AŞILDI<span class="sag">${new Date().toLocaleTimeString('tr-TR')}</span></h2>
        <div style="font-size:13px">${metin}</div></div>`; }
      if(sesAyar.sesliUyari && !window.__alarmSes){ window.__alarmSes = true;
        konus('Dikkat Üstad Kenan, ' + metin);
        setTimeout(()=>{ window.__alarmSes = false; }, 300000); }
      apiPost('/api/bildirim', {}).catch(()=>{});
    } else if(k){ k.innerHTML = ''; }
    return v;
  }).catch(()=>null);
}
SAYFALAR.alarm = async function(){
  const v = await apiHizli('/api/alarm', 5000);
  const a = v.ayar||{};
  $saf('#orta').innerHTML = `
  <div class="kutu" id="alarmKutu"><h2>${IK.kalkan} EŞİK ALARMI<span class="sag">${v.alarmVar? 'EŞİK AŞILDI' : 'her şey normal'}</span></h2>
    <div class="serit"><div class="sol"><div class="baslik">Alarm durumu</div>
      <div class="alt">${v.alarmVar? (v.ihlal||[]).join(' · ') : 'Tüm değerler eşiklerin altında.'}</div></div>
      <button class="dev-buton" id="alTest">${IK.saat} Şimdi kontrol et</button></div>
    <div class="sayaclar" style="grid-template-columns:1fr 1fr">
      <label class="sayac"><div class="basi"><span>İŞLEMCİ EŞİĞİ</span><b><input id="alCpu" class="inp" style="width:56px" value="${a.cpu||90}"></b></div></label>
      <label class="sayac"><div class="basi"><span>BELLEK EŞİĞİ</span><b><input id="alRam" class="inp" style="width:56px" value="${a.ram||90}"></b></div></label>
      <label class="sayac"><div class="basi"><span>DİSK EŞİĞİ</span><b><input id="alDisk" class="inp" style="width:56px" value="${a.disk||90}"></b></div></label>
      <label class="sayac"><div class="basi"><span>SICAKLIK EŞİĞİ (°C)</span><b><input id="alSicak" class="inp" style="width:56px" value="${a.sicaklik||85}"></b></div></label>
    </div>
    <div class="serit" style="margin-top:8px">
      <div class="sol"><div class="baslik">Sesli bildirim</div><div class="alt">Eşik aşılınca ve işler bitince Türkçe sesli uyarı verir.</div></div>
      <label><input type="checkbox" id="alSes" ${a.sesliUyari?'checked':''}> Açık</label></div>
    <div class="serit">
      <div class="sol"><div class="baslik">Telegram bildirimi (isteğe bağlı)</div>
        <div class="alt">Bot token ve sohbet kimliği girersen eşik aşılınca telefonuna mesaj gelir. Boş bırakırsan yalnız panel uyarır.</div></div>
      <button class="dev-buton" id="alKaydet">${IK.kalkan} Kaydet</button></div>
    <div class="bilgi-satir">
      <div class="b"><div class="et">BOT TOKEN</div><div class="de"><input id="alTok" class="inp" style="width:100%" value="${a.telegramToken||''}" placeholder="123456:ABC..."></div></div>
      <div class="b"><div class="et">SOHBET KİMLİĞİ</div><div class="de"><input id="alSoh" class="inp" style="width:100%" value="${a.telegramChat||''}" placeholder="123456789"></div></div>
    </div>
    <div id="alDeger" class="bos" style="margin-top:8px"></div></div>
  <div class="kutu"><h2>${IK.islemci} ŞU ANKİ DEĞERLER</h2><div id="alSimdi" class="bos">okunuyor…</div></div>`;
  $saf('#sag').innerHTML = `<div class="kutu"><h2>${IK.saat} SESLİ DENEME</h2>
    <div class="hizli yesil" id="alSesDene">${IK.pencere}<div><b>"Nöbetteyiz Üstad Kenan"</b><span>sesli bildirimi dene</span></div></div>
    <div class="hizli mavi" id="alTgDene">${IK.kalkan}<div><b>Telegram test mesajı</b><span>token girildiyse gönderir</span></div></div></div>`;
  const degerCiz = ()=>{
    apiHizli('/api/alarm', 4000).then(x=>{
      const k = x.kontrol||{};
      $saf('#alSimdi').innerHTML = `<div class="satir"><span class="ad">İşlemci</span><span class="boyut">${k.cpuYuk||0}%</span></div>
        <div class="satir"><span class="ad">Bellek</span><span class="boyut">${k.ramYuzde||0}%</span></div>
        <div class="satir"><span class="ad">Disk</span><span class="boyut">${k.diskYuzde||0}%</span></div>
        <div class="satir"><span class="ad">Sağlık puanı</span><span class="boyut">${k.puan||'—'}/100</span></div>`;
      $saf('#alDeger').innerHTML = x.alarmVar? `<span class="kutucuk kirmizi">EŞİK AŞILDI: ${(x.ihlal||[]).join(' · ')}</span>`
        : '<span class="kutucuk yesil">Her şey normal</span>';
    });
  };
  degerCiz();
  $saf('#alTest').onclick = async ()=>{ onbTazele(); const x = await alarmKontrol(); degerCiz();
    bildir('Alarm kontrolü', x && x.alarmVar? 'Eşik aşıldı: '+(x.ihlal||[]).join(' · ') : 'Tüm değerler normal', x&&x.alarmVar?'uyari':'bilgi'); };
  $saf('#alKaydet').onclick = async ()=>{
    const v2 = await apiPost('/api/alarm/kaydet', {cpu: $saf('#alCpu').value, ram: $saf('#alRam').value,
      disk: $saf('#alDisk').value, sicaklik: $saf('#alSicak').value, sesliUyari: $saf('#alSes').checked,
      telegramToken: $saf('#alTok').value.trim(), telegramChat: $saf('#alSoh').value.trim()});
    sesAyar = v2.ayar||sesAyar; onbTazele();
    bildir('Alarm', v2.mesaj||'Kaydedildi', 'bilgi');
  };
  $saf('#alSesDene').onclick = ()=> bildir('Sesli bildirim', konus('Nöbetteyiz Üstad Kenan. Sistem nöbette.')? 'Çalıştı.' : 'Bu panelde sesli okuma yok.', 'bilgi');
  $saf('#alTgDene').onclick = async ()=>{ const r = await apiPost('/api/bildirim', {});
    bildir('Telegram', r.mesaj||r.hata||'gönderilmedi', r.gonderildi? 'bilgi':'uyari'); };
};
async function alarmBaslat(){
  await alarmKontrol();
  if(ALARM_ZAMAN) clearInterval(ALARM_ZAMAN);
  ALARM_ZAMAN = setInterval(alarmKontrol, 45000);
}


  $$('#menu .oge').forEach(o=>o.onclick = ()=>goster(o.dataset.sayfa));
  $$('#ustSekmeler button').forEach(b=>b.onclick = ()=>goster(b.dataset.git));
  const h = (location.hash||'').match(/sayfa=([a-z]+)/);
  goster(h && SAYFALAR[h[1]] ? h[1] : 'panel');
  /* derin baglanti: #...palet -> komut paleti acik gelir */
  if((location.hash||'').includes('palet')) setTimeout(paletAc, 1500);
  alarmBaslat();
  setInterval(async ()=>{
    if(AKTIF==='panel'){ const d = await apiGet('/api/durum'); if(!d.hata){ DURUM=d; } }
  }, 5000);
})();
</script>
</body>
</html>
